{
  "name": "money-glitch",
  "displayName": "money-glitch",
  "description": "",
  "version": "1.0.7",
  "author": "Maleficentt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maleficentt/money-glitch.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moneyGlitch",
          "title": "Money Glitch",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "moneyGlitch": [
        {
          "id": "stocks",
          "name": "",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "moneyGlitch.refreshStocks",
        "title": "刷新",
        "category": "Money Glitch",
        "icon": "$(refresh)"
      },
      {
        "command": "moneyGlitch.addStock",
        "title": "添加",
        "category": "Money Glitch",
        "icon": "$(add)"
      },
      {
        "command": "moneyGlitch.deleteStock",
        "title": "删除"
      },
      {
        "command": "moneyGlitch.addToStatusBar",
        "title": "添加至状态栏"
      },
      {
        "command": "moneyGlitch.positionManagement",
        "title": "持仓",
        "icon": {
          "dark": "resources/position_dark.svg",
          "light": "resources/position_light.svg"
        }
      },
      {
        "command": "moneyGlitch.setStockPosition",
        "title": "持仓设置"
      },
      {
        "command": "moneyGlitch.buyStock",
        "title": "股票买入"
      },
      {
        "command": "moneyGlitch.sellStock",
        "title": "股票卖出"
      },
      {
        "command": "moneyGlitch.moveUp",
        "title": "上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "moneyGlitch.moveDown",
        "title": "下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "moneyGlitch.selectedDetail",
        "title": "自选详情",
        "icon": {
          "dark": "resources/selected_dark.svg",
          "light": "resources/selected_light.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moneyGlitch.refreshStocks",
          "when": "view == stocks",
          "group": "navigation@1"
        },
        {
          "command": "moneyGlitch.addStock",
          "when": "view == stocks",
          "group": "navigation@2"
        },
        {
          "command": "moneyGlitch.positionManagement",
          "when": "view == stocks",
          "group": "navigation@3"
        },
        {
          "command": "moneyGlitch.selectedDetail",
          "when": "view == stocks",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "moneyGlitch.moveUp",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "inline"
        },
        {
          "command": "moneyGlitch.moveDown",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "inline"
        },
        {
          "command": "moneyGlitch.moveUp",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group1"
        },
        {
          "command": "moneyGlitch.moveDown",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group1"
        },
        {
          "command": "moneyGlitch.setStockPosition",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.buyStock",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.sellStock",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.addToStatusBar",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group3"
        },
        {
          "command": "moneyGlitch.deleteStock",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stocks",
        "contents": "暂无数据"
      }
    ],
    "configuration": {
      "properties": {
        "moneyGlitch.indexSymbols": {
          "type": "array",
          "default": [
            "SH000001",
            "SZ399001",
            "SZ399006",
            "SH000688"
          ],
          "description": "List of index symbol"
        },
        "moneyGlitch.stockSymbols": {
          "type": "array",
          "default": [
            "SH000001",
            "SZ399001",
            "SZ399006",
            "SH000688"
          ],
          "description": "List of stock symbol"
        },
        "moneyGlitch.statusBarStockSymbols": {
          "type": "array",
          "default": [],
          "description": "List of stock symbol in statusBar"
        },
        "moneyGlitch.position": {
          "type": "object",
          "default": {
            "SH603043": {
              "cost": 14,
              "shares": 3000
            }
          },
          "description": "stock position detail"
        },
        "moneyGlitch.commonCommissionRate": {
          "type": "number",
          "default": 0.0002354,
          "description": "股票佣金费率"
        },
        "moneyGlitch.etfCommissionRate": {
          "type": "number",
          "default": 0.00025,
          "description": "etf佣金费率"
        },
        "moneyGlitch.stampTaxRate": {
          "type": "number",
          "default": 0.0005,
          "description": "印花税费率"
        },
        "moneyGlitch.transferRate": {
          "type": "number",
          "default": 0.00001,
          "description": "过户费率"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "iconv-lite": "^0.7.2",
    "node-cron": "^4.2.1"
  }
}
