{
  "name": "money-glitch",
  "displayName": "money-glitch",
  "description": "",
  "version": "1.0.16",
  "author": "Maleficentt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maleficentt/money-glitch.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moneyGlitch",
          "title": "Money Glitch",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "moneyGlitch": [
        {
          "id": "stocks",
          "name": "",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "moneyGlitch.correctDailyProfit",
        "title": "补录/修正每日收益",
        "category": "Money Glitch"
      },
      {
        "command": "moneyGlitch.refreshStocks",
        "title": "刷新",
        "category": "Money Glitch",
        "icon": "$(refresh)"
      },
      {
        "command": "moneyGlitch.addStock",
        "title": "添加",
        "category": "Money Glitch",
        "icon": "$(add)"
      },
      {
        "command": "moneyGlitch.deleteStock",
        "title": "删除"
      },
      {
        "command": "moneyGlitch.addToStatusBar",
        "title": "添加至状态栏"
      },
      {
        "command": "moneyGlitch.positionManagement",
        "title": "持仓",
        "icon": {
          "dark": "resources/position_dark.svg",
          "light": "resources/position_light.svg"
        }
      },
      {
        "command": "moneyGlitch.setStockPosition",
        "title": "持仓设置"
      },
      {
        "command": "moneyGlitch.buyStock",
        "title": "股票买入"
      },
      {
        "command": "moneyGlitch.sellStock",
        "title": "股票卖出"
      },
      {
        "command": "moneyGlitch.moveUp",
        "title": "上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "moneyGlitch.moveDown",
        "title": "下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "moneyGlitch.selectedDetail",
        "title": "自选详情",
        "icon": {
          "dark": "resources/selected_dark.svg",
          "light": "resources/selected_light.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moneyGlitch.refreshStocks",
          "when": "view == stocks",
          "group": "navigation@1"
        },
        {
          "command": "moneyGlitch.addStock",
          "when": "view == stocks",
          "group": "navigation@2"
        },
        {
          "command": "moneyGlitch.positionManagement",
          "when": "view == stocks",
          "group": "navigation@3"
        },
        {
          "command": "moneyGlitch.selectedDetail",
          "when": "view == stocks",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "moneyGlitch.moveUp",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "inline"
        },
        {
          "command": "moneyGlitch.moveDown",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "inline"
        },
        {
          "command": "moneyGlitch.moveUp",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group1"
        },
        {
          "command": "moneyGlitch.moveDown",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group1"
        },
        {
          "command": "moneyGlitch.setStockPosition",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.buyStock",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.sellStock",
          "when": "view == stocks && viewItem == stock",
          "group": "group2"
        },
        {
          "command": "moneyGlitch.addToStatusBar",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group3"
        },
        {
          "command": "moneyGlitch.deleteStock",
          "when": "view == stocks && (viewItem == stock || viewItem === index)",
          "group": "group4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stocks",
        "contents": "暂无数据"
      }
    ],
    "configuration": {
      "properties": {
        "moneyGlitch.indexSymbols": {
          "type": "array",
          "default": [
            "SH000001",
            "SZ399001",
            "SZ399006",
            "SH000688"
          ],
          "description": "List of index symbol"
        },
        "moneyGlitch.stockSymbols": {
          "type": "array",
          "default": [
            "SH000001",
            "SZ399001",
            "SZ399006",
            "SH000688"
          ],
          "description": "List of stock symbol"
        },
        "moneyGlitch.statusBarStockSymbols": {
          "type": "array",
          "default": [],
          "description": "List of stock symbol in statusBar"
        },
        "moneyGlitch.position": {
          "type": "object",
          "default": {
            "SH603043": {
              "cost": 14,
              "shares": 3000
            }
          },
          "description": "stock position detail"
        },
        "moneyGlitch.groupByRegion": {
          "type": "boolean",
          "default": true,
          "description": "enable group"
        },
        "moneyGlitch.broker": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hkStockConnect": {
                "type": "object",
                "description": "港股通费用配置。比例使用小数（万三为0.0003）；佣金未单独配置时沿用该券商已有参数。税费以港元逐项计算，选择无券商时仍按零费用处理。",
                "additionalProperties": false,
                "properties": {
                  "commissionRate": { "type": "number", "minimum": 0, "description": "港股通净佣金比例（不含下面单独计算的税费）；未填则沿用 commissionRate，请按账户协议设置。" },
                  "minCommission": { "type": "number", "minimum": 0, "description": "最低佣金；未填则沿用 stockMinCommission 或 etfMinCommission，币种由 minimumCommissionCurrency 指定。" },
                  "minimumCommissionCurrency": { "type": "string", "enum": ["HKD", "CNY"], "description": "最低佣金币种，默认 HKD。设为 CNY 时按当前可用汇率折算港元。" },
                  "stampTaxRate": { "type": "number", "minimum": 0, "description": "双向股票印花税比例，默认 0.001；向上取整到港元；ETF 豁免。" },
                  "tradingFeeRate": { "type": "number", "minimum": 0, "description": "联交所交易费比例，默认 0.0000565。" },
                  "transactionLevyRate": { "type": "number", "minimum": 0, "description": "证监会交易征费比例，默认 0.000027。" },
                  "afrcLevyRate": { "type": "number", "minimum": 0, "description": "会财局交易征费比例，默认 0.0000015。" },
                  "settlementFeeRate": { "type": "number", "minimum": 0, "description": "中国结算港股通股份交收费比例，默认 0.000042。" }
                }
              }
            }
          },
          "default": {
            "PingAn": {
              "code": "PingAn",
              "name": "平安证券",
              "commissionRate": 0.0002354,
              "stampTaxRate": 0.0005,
              "transferRate": {
                "value": 0.00001,
                "isBilateral": true
              },
              "stockMinCommission": 5,
              "etfMinCommission": 5,
              "hkStockConnect": {
                "minimumCommissionCurrency": "HKD",
                "stampTaxRate": 0.001,
                "tradingFeeRate": 0.0000565,
                "transactionLevyRate": 0.000027,
                "afrcLevyRate": 0.0000015,
                "settlementFeeRate": 0.000042
              }
            },
            "EastMoney": {
              "code": "EastMoney",
              "name": "东方财富",
              "commissionRate": 0.00025,
              "stampTaxRate": 0.0005,
              "transferRate": {
                "value": 0.00001,
                "isBilateral": false,
                "SZ": 0
              },
              "stockMinCommission": 5,
              "etfMinCommission": 0,
              "hkStockConnect": {
                "minimumCommissionCurrency": "HKD",
                "stampTaxRate": 0.001,
                "tradingFeeRate": 0.0000565,
                "transactionLevyRate": 0.000027,
                "afrcLevyRate": 0.0000015,
                "settlementFeeRate": 0.000042
              }
            }
          },
          "description": "Brokerage fees"
        },
        "moneyGlitch.monthlyProfit": {
          "type": "number",
          "default": 0,
          "description": "The waxing and waning of the month"
        },
        "moneyGlitch.monthlyProfitRevision": {
          "type": "string",
          "default": "",
          "description": "月收益自动写入的内部修订号，用于多窗口同步，请勿手动修改。"
        },
        "moneyGlitch.showMonthlyProfit": {
          "type": "boolean",
          "default": false,
          "description": "在状态栏及悬浮提示中显示月收益。关闭后仍会自动结算并保存月收益。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test tests",
    "test:integration": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "iconv-lite": "^0.7.2"
  },
  "volta": {
    "node": "20.20.2"
  }
}
